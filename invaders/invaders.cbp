<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="invaders" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/invaders" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-lmingw32" />
					<Add option="-lSDL2main" />
					<Add option="-lSDL2" />
					<Add option="-lSDL2_image" />
					<Add option="-mwindows" />
					<Add option="-lm" />
					<Add option="-ldinput8" />
					<Add option="-ldxguid" />
					<Add option="-ldxerr8" />
					<Add option="-luser32" />
					<Add option="-lgdi32" />
					<Add option="-lwinmm" />
					<Add option="-limm32" />
					<Add option="-lole32" />
					<Add option="-loleaut32" />
					<Add option="-lshell32" />
					<Add option="-lversion" />
					<Add option="-luuid" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/invaders" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
			<Target title="Debug Linux">
				<Option output="invaders" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-pedantic" />
					<Add option="-Wextra" />
					<Add option="-Wall" />
					<Add option="-std=c11" />
					<Add option="-m64" />
					<Add option="-g" />
					<Add option="-Werror" />
					<Add directory="../include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-m64" />
					<Add option="-lSDL2" />
					<Add option="-lSDL2_image" />
					<Add option="-lSDL2_mixer" />
					<Add directory="/usr/lib64" />
					<Add directory="/usr/lib" />
				</Linker>
			</Target>
			<Target title="Release Linux">
				<Option output="invaders" prefix_auto="1" extension_auto="1" />
				<Option type="0" />
				<Option compiler="gcc" />
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="../include/bullet.h" />
		<Unit filename="../include/convert.h" />
		<Unit filename="../include/enemy.h" />
		<Unit filename="../include/ship.h" />
		<Unit filename="../include/utils.h" />
		<Unit filename="../include/video.h" />
		<Unit filename="../include/win.h" />
		<Unit filename="../src/bullet.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/convert.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/enemy.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/invaders.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/ship.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/video.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="../src/win.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
